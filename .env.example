# mock | live  (per-integration overrides below)
ADAPTER_MODE=mock
# RESULTS_ADAPTER=live
# TCM_ADAPTER=live
# DEFECTS_ADAPTER=live
# REVALIDATION_ADAPTER=live

# Allure: one sub-directory of allure-results per execution
ALLURE_RESULTS_DIR=/data/allure-results

# Zephyr Scale Cloud
ZEPHYR_API_TOKEN=
# ZEPHYR_BASE_URL=https://api.zephyrscale.smartbear.com/v2

# Jira Cloud
JIRA_BASE_URL=https://yourco.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=SHOP
# JIRA_SEVERITY_FIELD=customfield_10050

# Playwright MCP
PLAYWRIGHT_BASE_URL=https://staging.yourapp.example
# PLAYWRIGHT_MCP_URL=http://localhost:8931/mcp

# Optional LLM (falls back to the built-in heuristic provider)
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=
